[Unit]
Description=Framefinder Telegram gallery bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=gallery
Group=gallery
WorkingDirectory=/opt/gallery
EnvironmentFile=/etc/gallery-bot.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/opt/gallery/.venv/bin/python -m gallery.check
ExecStart=/opt/gallery/.venv/bin/python -m gallery.bot
Restart=always
RestartSec=15
StateDirectory=gallery
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gallery
PrivateTmp=true

[Install]
WantedBy=multi-user.target
