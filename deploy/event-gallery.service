[Unit]
Description=Private event gallery Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/event-gallery
EnvironmentFile=/home/ubuntu/event-gallery/.env
ExecStart=/home/ubuntu/event-gallery/.venv/bin/python -m gallery.bot
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/event-gallery/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
